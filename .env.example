# Required for the protected admin dashboard. Set only in the server/deployment environment.
# Generate a unique password hash with:
# node -e "const c=require('node:crypto'); const s=c.randomBytes(24).toString('hex'); console.log('ADMIN_PASSWORD_SALT='+s); console.log('ADMIN_PASSWORD_HASH='+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=replace-with-a-128-character-scrypt-hash
ADMIN_PASSWORD_SALT=replace-with-a-random-salt-at-least-16-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
